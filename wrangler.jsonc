{
  // Configuration Cloudflare du quiz « Devine l'animé »
  "name": "quiz-anime",
  "main": "src/worker.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "GAME", "class_name": "Game" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Game"] }]
}
